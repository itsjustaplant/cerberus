{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vault",
  "main": "workers/app.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  // Keep generated public endpoints disabled for this personal app.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vault",
      // Local placeholder. Replace with a provisioned D1 ID before deployment.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "CAPTURE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "vault-files",
    },
  ],
}
