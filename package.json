{
  "name": "cerberus",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A personal collection of bookmarks, links, and images on Cloudflare.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:production": "CLOUDFLARE_ENV=production react-router build",
    "deploy:production": "npm run build:production && wrangler deploy --config build/server/wrangler.json",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "preview": "npm run build && vite preview --host 127.0.0.1",
    "cf:typegen": "wrangler types --include-runtime=false",
    "typecheck": "npm run cf:typegen && react-router typegen && tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply vault --local",
    "test:integration": "npm run build && node scripts/test-integration.mjs",
    "test:tweets": "tsx --test scripts/tweets.test.ts",
    "test:storage": "tsx --test scripts/storage.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "isbot": "^5",
    "lucide-react": "^1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.68.0",
    "@cloudflare/workers-types": "5.20261109.1",
    "@react-router/dev": "8.5.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "wrangler": "4.159.0"
  }
}
